{
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "vendor": "deno run --allow-net --allow-write vendor.ts"
  },
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "nodeModulesDir": "auto",
  "imports": {
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "date-fns": "npm:date-fns@^2.29.3",
    "devtools-detect": "npm:devtools-detect@^4.0.2",
    "lodash.kebabcase": "npm:lodash.kebabcase@^4.1.1",
    "preact": "npm:preact@^10.28.3",
    "preact/": "npm:preact@^10.28.3/",
    "@preact/signals": "npm:@preact/signals@^2.7.1",
    "fresh": "jsr:@fresh/core@^2.2.2",
    "simple-icons": "npm:simple-icons@13.15.0",
    "simple-icons-twitter": "npm:simple-icons@9.7.0",
    "vite": "npm:vite@^8.0.8"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*", "vendor/"]
}
